# include <stdio.h>
# include <stdlib.h>
int fsum(int A[], int N){
    int summa = 0;
    for (int i=0; i < N; i++){
        summa += A[i];
    }
    return summa;
}

int countf(int A[], int N, int x){
   int counta = 0;
   for (int i = 0; i < N; i++){
       if (A[i] == x){
           counta+=1;
       }
           
   }
   return counta;
}

int compare(const void*a, const void*b){
    return(*(int*)a - *(int*)b);
}

